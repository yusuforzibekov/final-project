{
  "scripts": {
    "test": "jest --reporters=jest-junit",
    "build": "echo \"Dummy build script for Autocode\"",
    "compile": "node-sass src/styles/styles.scss src/dist/styles.css",
    "prefix": "npx postcss src/dist/styles.css -o src/dist/styles.css",
    "min": "postcss src/dist/styles.css -o src/dist/styles.min.css",
    "unused": "purgecss --css src/dist/styles.css --content src/index.html",
    "lint": "stylelint ./src/styles/*.scss --fix && stylelint ./src/styles/*.scss",
    "prettier": "prettier --write src/styles/*.scss && prettier --write \"src/dist/styles.css\"",
    "prod": "npm run compile && npm run prefix && npm run unused && npm run min"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "clean-css-cli": "^5.6.3",
    "cssnano": "^6.0.3",
    "html-validate": "^8.7.4",
    "jest": "29.7",
    "jest-junit": "^13.2.0",
    "jsdom": "^19.0.0",
    "parse-gitignore": "^2.0.0",
    "postcss": "^8.4.33",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.0.0",
    "prettier": "^3.1.1",
    "purify-css": "^1.1.9",
    "stylelint": "^16.1.0",
    "stylelint-config-standard": "^35.0.0",
    "stylelint-scss": "^6.0.0"
  },
  "jest-junit": {
    "suiteName": "junit test results",
    "outputDirectory": ".",
    "outputName": "junit.xml"
  },
  "dependencies": {
    "node-sass": "^9.0.0",
    "prefixer": "^0.0.3",
    "purgecss": "^5.0.0"
  }
}
